// ---------------- FREDDY / FNAF STYLE ----------------

// Locked on you, heavy lids, no blinking (interrupted by Serial input)
void stare(unsigned long ms) {
  head(UD_CENTER, T_CENTER);
  both(EYE_CENTER, LID_REST, 300, EASE_INOUT);
  hold(ms);
}

// Slow, heavy blink
void heavyBlink() {
  lidsTo(LID_CLOSED, 450, EASE_INOUT);
  delay(300);
  lidsTo(LID_REST, 500, EASE_INOUT);
}

// Half-lidded, stiff slow turn, freeze, then SNAP back to you
void creepyTurn() {
  head(UD_CENTER + 4, headFromEye(EYE_MIN + 3));   // head turns with the lids
  lidsTo(35, 600, EASE_INOUT);
  stiffTo(EYE_MIN + 3, 3, 70, 90);
  delay(1800);
  head(UD_CENTER, T_CENTER);
  both(EYE_CENTER, LID_WIDE, 70, EASE_OUT);   // snap
  delay(1500);
  lidsTo(LID_REST, 600, EASE_INOUT);
}

// Stalking: head lowers and lids slowly narrow while it stares, then snap wide
void stalk() {
  head(UD_CENTER, T_CENTER);
  both(EYE_CENTER, LID_REST, 300, EASE_INOUT);
  head(UD_CENTER + 6, T_CENTER);
  lidsTo(28, 3500, EASE_INOUT);
  delay(1200);
  head(UD_CENTER - 2, T_CENTER);
  lidsTo(LID_WIDE, 90, EASE_OUT);
  delay(700);
  head(UD_CENTER, T_CENTER);
  lidsTo(LID_REST, 500, EASE_INOUT);
}

// Electrical glitch: random twitching and lid flicker
void glitch() {
  int n = random(8, 14);
  for (int i = 0; i < n; i++) {
    snapEyes(EYE_CENTER + random(-10, 11), EYE_CENTER + random(-10, 11));
    snapLids(random(0, 70));
    delay(random(30, 90));
  }
  both(EYE_CENTER, LID_REST, 120, EASE_OUT);
}

// Faulty servo: one eye jerks on its own
void twitch() {
  int n = random(4, 8);
  for (int i = 0; i < n; i++) {
    float off = random(4, 9) * (random(2) ? 1 : -1);
    if (random(2)) snapEyes(EYE_CENTER + off, EYE_CENTER);
    else           snapEyes(EYE_CENTER, EYE_CENTER + off);
    delay(random(40, 120));
    snapEyes(EYE_CENTER, EYE_CENTER);
    delay(random(150, 700));
  }
}

// One eye slowly drifts off, then both correct
void lazyEye() {
  both(EYE_CENTER, LID_REST, 300, EASE_INOUT);
  animate(EYE_CENTER + 18 * LAZY_DIR, EYE_CENTER, lL, lR, 2500, EASE_INOUT);
  delay(1800);
  animate(EYE_CENTER, EYE_CENTER, LID_REST, LID_REST, 90, EASE_OUT);
  delay(800);
}

// Rapid half-blinks, like a nervous system
void lidFlutter() {
  int n = random(6, 10);
  for (int i = 0; i < n; i++) {
    lidsTo(random(40, 75), 50, EASE_LINEAR);
    lidsTo(LID_REST, 50, EASE_LINEAR);
  }
  delay(300);
  blink();
}

// Wide eyes, head lunges forward, violent shaking that dies down, dead stare
void jumpscare() {
  snapLids(LID_WIDE);
  snapHead(UD_DOWN - 3, T_CENTER);
  for (int amp = 25; amp >= 3; amp -= 2) {
    snapEyes(EYE_CENTER + amp, EYE_CENTER + amp);
    delay(35);
    snapEyes(EYE_CENTER - amp, EYE_CENTER - amp);
    delay(35);
  }
  both(EYE_CENTER, LID_WIDE, 100, EASE_OUT);
  delay(1500);
  head(UD_CENTER, T_CENTER);
  lidsTo(LID_REST, 900, EASE_INOUT);
}

// Power runs out: stuttering, lids sag fully shut and stay shut
void powerDown() {
  head(UD_DOWN - 6, T_CENTER);   // head sags as the power dies
  eyesTo(EYE_CENTER, 300, EASE_INOUT);
  float p = lL;
  while (p < 100) {
    p += random(6, 16);
    if (p > 100) p = 100;
    lidsTo(p, random(60, 140), EASE_OUT);
    delay(random(80, 300));
    if (random(4) == 0 && p < 95) {
      lidsTo(p - 15, 60, EASE_LINEAR);
      delay(40);
      lidsTo(p, 60, EASE_LINEAR);
    }
  }
  lidsTo(LID_CLOSED, 150, EASE_OUT);
  delay(SETTLE_MS);
}

// Power comes back: jerky wake-up, glitch, then dead stare
void powerUp() {
  head(UD_CENTER, T_CENTER);
  float p = lL;
  while (p > LID_REST) {
    p -= random(10, 28);
    if (p < LID_REST) p = LID_REST;
    lidsTo(p, random(50, 120), EASE_OUT);
    delay(random(60, 220));
  }
  glitch();
  stare(800);
}

// Camera-like stiff sweep, then locks onto you
void watchYou() {
  lidsTo(20, 300, EASE_INOUT);
  stiffTo(EYE_MAX, 4, 60, 90);
  delay(700);
  stiffTo(EYE_MIN, 4, 60, 90);
  delay(700);
  stiffTo(EYE_CENTER, 4, 60, 90);
  lidsTo(LID_REST, 300, EASE_INOUT);
  delay(1500);
}

// Freddy idle loop: mostly staring, with rare creepy events
void freddyStep() {
  int roll = random(100);
  if (roll < 30)      stare(random(2500, 6000));
  else if (roll < 45) heavyBlink();
  else if (roll < 57) creepyTurn();
  else if (roll < 67) watchYou();
  else if (roll < 75) stalk();
  else if (roll < 83) twitch();
  else if (roll < 88) lazyEye();
  else if (roll < 93) lidFlutter();
  else                glitch();

  // make sure the head is back at center before the next event
  if (fabs(hUD - UD_CENTER) > 0.5f || fabs(hT - T_CENTER) > 0.5f) goHome(500);
  hold(random(500, 1500));
}

// ---------------- NORMAL IDLE (LIFE-LIKE) ----------------

// Waits, blinking on schedule; returns early if a Serial command arrives
void wait(unsigned long ms) {
  unsigned long start = millis();
  while (millis() - start < ms) {
    if (Serial.available()) return;
    if (millis() >= nextBlinkAt) {
      blink();
      scheduleBlink();
    }
    delay(5);
  }
}

// Sometimes the head follows the eyes, sometimes it returns to center
void headFollow(float eyeTarget) {
  if (random(100) < 45) head(UD_CENTER + random(-4, 5), headFromEye(eyeTarget));
  else                  head(UD_CENTER, T_CENTER);
}

void idleStep() {
  int roll = random(100);
  float target = random(EYE_MIN + 5, EYE_MAX - 5);

  if (roll < 50)      { headFollow(target); eyesTo(target, random(60, 110), EASE_OUT); }     // quick glance
  else if (roll < 75) { headFollow(target); eyesTo(target, random(300, 700), EASE_INOUT); }  // slow drift
  else if (roll < 79) doubleBlink();
  else if (roll < 83) lookAroundHead();
  else if (roll < 89) companionTrick();
  else if (roll < 96) { if (random(2)) funTrick(); else comboTrick(); }
  else                { head(UD_CENTER, T_CENTER); eyesTo(EYE_CENTER, 400, EASE_INOUT); }
  wait(random(600, 2600));
}

// ---------------- SERIAL CONTROL ----------------
// EYES:  b blink | d double blink | l wink left | r wink right | s sleepy
//        u surprised | c cross-eyed | x scan | n shake no | q suspicious
//        e skeptical | a angry | h heavy blink | k creepy turn | y stalk
//        g glitch | t twitch | m lazy eye | o lid flutter | j jumpscare
//        p power down | w power up | v watch you | z lid test
// HEAD:  Y nod yes | N head shake no | L look around | C curious | E excited
//        X stretch | S shy | D double take | H heard something | R radar scan
//        B bored | O go home (center everything)
// FUN:   1 dizzy | 2 sneeze | 3 yawn | 4 scared | 5 peekaboo | 6 tennis
//        7 eye roll | 8 dreamy | 9 evil laugh | 0 boot up
// COMBO: A spy | T target lock | W wake-up routine | F chase fly | P show off
//        Q thinking | G sees ghost | J dance | M hypnotize | K crash+reboot | U sad
// MODES: f freddy mode | i idle mode
// Lid calibration: + / - = left closed angle, ] / [ = right closed angle

void handleSerial() {
  if (!Serial.available()) return;
  char c = Serial.read();
  switch (c) {
    case 'b': blink();        break;
    case 'd': doubleBlink();  break;
    case 'l': winkLeft();     break;
    case 'r': winkRight();    break;
    case 's': sleepy();       break;
    case 'u': surprised();    break;
    case 'c': crossEyes();    break;
    case 'x': scan();         break;
    case 'n': shakeNo();      break;
    case 'q': suspicious();   break;
    case 'e': skeptical();    break;
    case 'a': angry();        break;
    case 'h': heavyBlink();   break;
    case 'k': creepyTurn();   break;
    case 'y': stalk();        break;
    case 'g': glitch();       break;
    case 't': twitch();       break;
    case 'm': lazyEye();      break;
    case 'o': lidFlutter();   break;
    case 'j': jumpscare();    break;
    case 'p': powerDown();    break;
    case 'w': powerUp();      break;
    case 'v': watchYou();     break;
    case 'z': lidTest();      break;

    case 'Y': nodYes();         break;
    case 'N': headShakeNo();    break;
    case 'L': lookAroundHead(); break;
    case 'C': curious();        break;
    case 'E': excited();        break;
    case 'X': stretch();        break;
    case 'S': shy();            break;
    case 'D': doubleTake();     break;
    case 'H': heardSomething(); break;
    case 'R': scanHead();       break;
    case 'B': bored();          break;
    case 'O': goHome(600);      break;

    case '1': dizzy();          break;
    case '2': sneeze();         break;
    case '3': yawn();           break;
    case '4': scared();         break;
    case '5': peekaboo();       break;
    case '6': tennis();         break;
    case '7': eyeRoll();        break;
    case '8': dreamy();         break;
    case '9': evilLaugh();      break;
    case '0': bootUp();         break;

    case 'A': spyMode();        break;
    case 'T': targetLock();     break;
    case 'W': wakeUpRoutine();  break;
    case 'F': chaseFly();       break;
    case 'P': showOff();        break;
    case 'Q': thinking();       break;
    case 'G': seesGhost();      break;
    case 'J': dance();          break;
    case 'M': hypnotize();      break;
    case 'K': crashReboot();    break;
    case 'U': sad();            break;

    case '+': lidLClosed = min(180, lidLClosed + 5); showLidCal(); break;
    case '-': lidLClosed = max(100, lidLClosed - 5); showLidCal(); break;
    case ']': lidRClosed = max(0, lidRClosed - 5);   showLidCal(); break;
    case '[': lidRClosed = min(100, lidRClosed + 5); showLidCal(); break;

    case 'f':
      freddyMode = !freddyMode;
      Serial.println(freddyMode ? "freddy mode ON" : "freddy mode OFF");
      break;
    case 'i':
      idleMode = !idleMode;
      Serial.println(idleMode ? "idle ON" : "idle OFF");
      break;
  }
}

// ---------------- SETUP / LOOP ----------------

void setup() {
  Serial.begin(9600);
  randomSeed(analogRead(A0));

  leftEye.attach(LEFT_EYE_PIN);
  rightEye.attach(RIGHT_EYE_PIN);
  leftLid.attach(LEFT_LID_PIN);
  rightLid.attach(RIGHT_LID_PIN);
  headUD.attach(HEAD_UD_PIN);
  headT.attach(HEAD_T_PIN);

  writeEyes();
  writeLids();
  writeHead();
  delay(800);

  scheduleBlink();
  Serial.println("Ready");
  Serial.println("Eyes: b d l r s u c x n q e a h k y g t m o j p w v z");
  Serial.println("Head: Y N L C E X S D H R B O");
  Serial.println("Fun: 1 2 3 4 5 6 7 8 9 0");
  Serial.println("Combo: A T W F P Q G J M K U");
  Serial.println("Modes: f (freddy) i (idle) | lids: + - ] [");
}

void loop() {
  handleSerial();
  if (freddyMode)    freddyStep();
  else if (idleMode) idleStep();
}
